[Unit]
Description=Thaliyola team knowledge base (MCP server + web UI)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=thaliyola
Group=thaliyola
WorkingDirectory=/opt/thaliyola
EnvironmentFile=/etc/thaliyola/thaliyola.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/thaliyola/dist/index.js
Restart=on-failure
RestartSec=3

# Hardening (kept to options that also work in unprivileged containers)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/thaliyola

[Install]
WantedBy=multi-user.target
