{
  "mcpServers": {
    "thaliyola": {
      "type": "http",
      "url": "${THALIYOLA_URL}/mcp",
      "headers": {
        "Authorization": "Bearer ${THALIYOLA_TOKEN}",
        "X-Thaliyola-Project": "${THALIYOLA_PROJECT:-}",
        "X-Thaliyola-Component": "${THALIYOLA_COMPONENT:-}"
      }
    }
  }
}
