# Copy to .env and fill in.
PORT=8080
POSTGRES_PASSWORD=change-me

# local = built-in accounts (default); cloudflare = verify Cloudflare Access JWTs; dev = static tokens (development only)
AUTH_MODE=local
# Public https URL; in local mode it enables OAuth for claude.ai connectors
# PUBLIC_URL=https://cairn.example.com
# RATE_LIMIT_PER_MINUTE=600    requests per user per minute on /api and /mcp (0 disables)
# LOG_REQUESTS=true            one JSON line per request on stdout
# SESSION_TTL_HOURS=168
# COOKIE_SECURE=auto
# dev mode: comma-separated token=email pairs. Emails starting with "svc-" are service identities.
# DEV_TOKENS=dev-token=you@example.com

# Emails that can approve in any scope and manage projects/members
ADMIN_EMAILS=you@example.com
# Share of a proposal's terms an existing finding must contain to count as a near-duplicate (0-1)
DUPLICATE_THRESHOLD=0.6

# Uploaded screenshots and files (local disk)
ASSET_DIR=./data/assets
ASSET_MAX_BYTES=5242880
# Or store files in S3-compatible storage (AWS S3, Cloudflare R2, MinIO, Garage)
# ASSET_STORE=s3
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=cairn-assets
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Semantic search: local (bge-small, in-process, downloads ~35 MB once), hash (offline test embedder) or off
EMBEDDINGS=local
# EMBEDDING_CACHE_DIR=./data/models
# SEARCH_MIN_SIMILARITY=0.6
# DUPLICATE_SIMILARITY=0.8

# Freshness
# STALE_AFTER_DAYS=90
# STALE_AFTER_DAYS_ARTICLES=180
# MAINTENANCE_INTERVAL_HOURS=6

# cloudflare mode
# CF_ACCESS_TEAM_DOMAIN=https://<team>.cloudflareaccess.com
# CF_ACCESS_AUD=<Access application AUD tag>

# --profile tunnel
# CLOUDFLARE_TUNNEL_TOKEN=
