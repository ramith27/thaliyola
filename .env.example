# Copy to .env and fill in.
PORT=8080
POSTGRES_PASSWORD=change-me

# local = built-in accounts (default); cloudflare = verify Cloudflare Access JWTs; dev = static tokens (development only)
AUTH_MODE=local
# Public https URL; in local mode it enables OAuth for claude.ai connectors
# PUBLIC_URL=https://thaliyola.example.com
# RATE_LIMIT_PER_MINUTE=600    requests per user per minute on /api and /mcp (0 disables)
# LOG_REQUESTS=true            one JSON line per request on stdout
# SESSION_TTL_HOURS=168
# COOKIE_SECURE=auto
# dev mode: comma-separated token=email pairs. Emails starting with "svc-" are service identities.
# DEV_TOKENS=dev-token=you@example.com

# Emails that are Administrators (can do everything)
ADMIN_EMAILS=you@example.com
# New people who sign in through Cloudflare Access (or a dev token) wait until an admin approves them
# REQUIRE_APPROVAL=true
# New projects: members (only people given a role) or team (everyone signed in)
# DEFAULT_PROJECT_VISIBILITY=members
# Which proxies' X-Forwarded-For / -Proto to believe: loopback, a hop count (1 behind one cloud load balancer), true,
# or addresses / ranges (comma-separated)
# TRUST_PROXY=loopback
# On SIGTERM: seconds in-flight requests and jobs get to finish (keep below Kubernetes' terminationGracePeriodSeconds)
# SHUTDOWN_TIMEOUT_SECONDS=20

# Review and publishing
# DIRECT_PUBLISH=true               people who may publish (Project admins, by default) skip review for their own writes
# REVIEW_SELF_APPROVAL=true         reviewers may approve their own article and finding proposals (false: someone else must)
# ALLOW_MCP_APPROVALS=true          reviewers may approve, reject and publish through Claude (false: only in the web app)

# Connections: a project's databases, APIs, git hosts, Slack and Trello
# CONNECTIONS=on
# CONNECTIONS_KEY=                  encrypts connection secrets; 32 random bytes, base64: openssl rand -base64 32
# CONNECTIONS_KEY_OLD=              the previous key while rotating (secrets are re-sealed at start-up)
# CONNECTIONS_ALLOW_PRIVATE=false   true lets API, Slack, Trello and git connections reach private networks
# QUERY_MAX_ROWS=200                read-only database queries: rows returned (at most 1000)
# QUERY_TIMEOUT_MS=15000

# Claude skills
# SKILLS_DIRECT_PUBLISH=true        a Project admin's own skills in their project publish at once (needs DIRECT_PUBLISH)
# SKILLS_SELF_APPROVAL=false        true: one person may propose and approve a skill version (small teams only)
# SKILLS_GIT_HOSTS=                 private-network git hosts skill imports may reach (exact names, comma-separated)
# SKILLS_IMPORT_MAX_BYTES=52428800
# SKILLS_USAGE_DAYS=365             how long "who loaded which skill" is kept
# Share of a proposal's terms an existing finding must contain to count as a near-duplicate (0-1)
DUPLICATE_THRESHOLD=0.6

# Uploaded screenshots and files (local disk)
ASSET_DIR=./data/assets
ASSET_MAX_BYTES=5242880
# Largest document import upload (zip of Markdown/HTML pages and images)
IMPORT_MAX_BYTES=52428800
# Or store files in S3-compatible storage (AWS S3, Cloudflare R2, MinIO, Garage)
# ASSET_STORE=s3
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=thaliyola-assets
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Semantic search: local (bge-small, in-process, downloads ~35 MB once), hash (offline test embedder) or off
EMBEDDINGS=local
# EMBEDDING_CACHE_DIR=./data/models
# SEARCH_MIN_SIMILARITY=0.6
# DUPLICATE_SIMILARITY=0.8

# Notifications (always in-app; optionally email and a team Slack channel)
# MAIL_TRANSPORT=smtp
# SMTP_URL=smtps://user:password@mail.example.com:465
# MAIL_FROM=Thaliyola <thaliyola@example.com>
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/…

# Team sources: feeds, watched pages, Slack threads, Notion pages and searches fetched into the inbox
# SOURCES=on
# SLACK_BOT_TOKEN=xoxb-…            channels:history (groups:history for private channels), users:read
# NOTION_TOKEN=ntn_…                internal integration; share pages or databases with it
# TAVILY_API_KEY=tvly-…             web search sources
# SOURCES_ALLOW_PRIVATE=false       true lets feeds and page watches reach internal networks

# Vulnerabilities: uploaded lockfiles are matched against OSV.dev and re-checked daily; CISA KEV flags actively exploited ones
# VULN_SCAN=on
# OSV_API_URL=https://api.osv.dev
# KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
# Latest critical vulnerabilities worldwide (NVD, GitHub advisories, CISA KEV additions), every 6 hours
# ADVISORY_FEED=on
# NVD_API_KEY=                      optional; raises NVD's rate limit (https://nvd.nist.gov/developers/request-an-api-key)
# GITHUB_TOKEN=                     optional; raises GitHub's rate limit, and with read access to private repos lets Thaliyola
#                                   read their languages and dependency graph (fine-grained: Metadata + Contents read)
# GITLAB_TOKEN=                     optional; read_api token to read private GitLab repositories' languages (gitlab.com or self-hosted)

# Freshness
# STALE_AFTER_DAYS=90
# STALE_AFTER_DAYS_ARTICLES=180
# MAINTENANCE_INTERVAL_HOURS=6

# cloudflare mode
# CF_ACCESS_TEAM_DOMAIN=https://<team>.cloudflareaccess.com
# CF_ACCESS_AUD=<Access application AUD tag>

# --profile tunnel
# CLOUDFLARE_TUNNEL_TOKEN=

# Weekly digest email: day (0 = Sunday … 6 = Saturday) and hour, server local time
DIGEST_DAY=1
DIGEST_HOUR=8
# Days to keep searches for the hit rate and knowledge gaps
SEARCH_LOG_DAYS=180

# The /thaliyola slash command in Slack (search, ask a session or expert, declare an incident): the Slack app's
# signing secret, plus SLACK_BOT_TOKEN (scopes: commands, chat:write, users:read, users:read.email).
# SLACK_SIGNING_SECRET=

# Sign in with Google, Okta, Microsoft Entra or any OpenID Connect provider (local mode, needs PUBLIC_URL).
# Redirect URI to register: <PUBLIC_URL>/auth/oidc/<name>/callback
# OIDC_PROVIDERS=google
# OIDC_GOOGLE_ISSUER=https://accounts.google.com
# OIDC_GOOGLE_CLIENT_ID=
# OIDC_GOOGLE_CLIENT_SECRET=
# OIDC_ALLOWED_DOMAINS=example.com
# OIDC_ONLY=false

# Public demo only (never on a real install): wipes ALL data and re-seeds a showcase every DEMO_RESET_HOURS,
# with one-click demo accounts. Needs AUTH_MODE=local. The root Dockerfile runs it with its own database.
# DEMO_MODE=false
# DEMO_RESET_HOURS=12

# Native install: copy each daily backup to an S3-compatible bucket (and check monthly that it restores).
# BACKUP_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# BACKUP_S3_BUCKET=
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_REGION=auto
# BACKUP_S3_KEEP=30
# BACKUP_ENCRYPTION_KEY=
